# ── Server ────────────────────────────────────────────────
PORT=4000
# FE 오리진 (CORS 허용 목록, 콤마 구분). 스킴·포트는 정확히 일치해야 한다. 팀이 소유한 도메인에서는 호스트 레이블 하나에 `*` 한 개 허용
# (예: https://preview-*.ninjalabs.xyz).
# 예) https://ninjalabs.xyz,https://ninjalabsfe-git-develop-<team>.vercel.app,http://localhost:3000
# 주의: vercel.app 같은 공용 호스팅 도메인 위의 와일드카드는 `*`의 위치와 무관하게 안전하지 않다 — https://ninjalabsfe-*-<team>.vercel.app 도
# 공격자가 ninjalabsfe-evil-<team> 프로젝트를 만들면 통과한다. 그런 항목은 기동 시 error 로그 후 **무시된다** (아무 오리진도 허용하지 않음).
# 대상 접미사: vercel.app netlify.app pages.dev github.io railway.app herokuapp.com onrender.com fly.dev web.app firebaseapp.com.
# Vercel preview는 브랜치 고정 별칭을 **정확한 항목**으로 넣는다 (https://ninjalabsfe-git-develop-<team>.vercel.app) — 또는 커스텀 preview 도메인.
CORS_ORIGINS=http://localhost:3000
# 리버스 프록시 홉 수 (Railway/Fly/LB 뒤에서는 1). 0이면 X-Forwarded-For를 신뢰하지 않는다.
# NODE_ENV=production에서 미설정/빈 값이면 1로 보고 warn (Railway는 프록시 1홉 뒤), 명시적 0/비정수면 기동을 거부한다 (.railway/railway.ts가 1로 고정).
TRUST_PROXY=0
# production|development — production이면 기동 시 JWT_SECRET(미설정/자리표시값 → 거부, 32바이트 미만 → error 로그), GOOGLE_CLIENT_SECRET(미설정 → 거부),
# TRUST_PROXY(명시적 0/비정수 → 거부)를 검사한다. 전체 목록은 README "이 브랜치 첫 배포 전에 있어야 하는 env".
NODE_ENV=development

# ── Database (Supabase PostgreSQL) ────────────────────────
# Supabase 대시보드 → Project Settings → Database → Connection string (URI)
# 서버(NestJS)는 세션 풀러(포트 5432/6543) 중 5432 direct 또는 Supavisor session 모드 권장
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Supabase CA 인증서(PEM). 설정하면 서버 인증서를 검증한다(rejectUnauthorized: true), 비우면 검증 생략(기존 동작).
# Supabase 대시보드 → Project Settings → Database → SSL Configuration → Download certificate.
# 한 줄 env에 넣을 때는 줄바꿈을 \n 으로 이스케이프해도 된다. 로컬 Postgres는 PGSSLMODE=disable.
# NODE_ENV=production에서 비어 있으면 기동은 하되 부팅 시 warn 한 번 (인증서 미발급 상태 허용 — 운영 전 반드시 설정).
DATABASE_CA_CERT=

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 백엔드 콜백 URL (구글 콘솔에 등록 필요)
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# 로그인 완료 후 FE로 리다이렉트할 URL
AUTH_SUCCESS_REDIRECT=http://localhost:3000/
# 로그인 후 returnTo로 허용할 FE 오리진 (콤마 구분). CORS_ORIGINS와 같은 규칙 — AUTH_SUCCESS_REDIRECT의 오리진은 항상 허용된다.
# 예) https://ninjalabsfe-git-develop-<team>.vercel.app (Vercel 브랜치 별칭은 정확한 항목으로)
# 공용 호스팅 도메인(vercel.app 등) 위의 와일드카드는 returnTo로 로그인 코드를 탈취당할 수 있으므로 위치와 무관하게 거부된다 (CORS_ORIGINS와 동일).
AUTH_ALLOWED_REDIRECT_ORIGINS=

# ── Session (JWT) ─────────────────────────────────────────
# production에서는 랜덤 값 필수 — 이 자리표시값/미설정이면 기동 거부, 32바이트 미만이면 기동은 하되 error 로그(즉시 교체). 예: openssl rand -base64 48
JWT_SECRET=change-me-long-random-string
JWT_ACCESS_TTL=15m
# refresh 세션 수명 — `<정수> <단위>` 형식만 허용: s/sec/second(s), m/min/minute(s), h/hr/hour(s), d/day(s), w/week(s)
# 예: 14d, 15m, 2 weeks, 12h. `m`은 항상 분(minutes)이다 (월 아님). 허용 범위 60초 ~ 90일 — 잘못된 값/0/범위 밖이면 기동 시 실패한다.
JWT_REFRESH_TTL=14d
# 전환기(TODO remove after 2026-11-30): typ 클레임이 없는 구 access 토큰은 iat가 이 시각(ISO 8601) 이전일 때만 받는다.
# 비워 두면 프로세스 시작 시각 — 첫 배포 때 이미 발급돼 있던 토큰만 15분 동안 통과한다. 파싱 불가 값은 기동 거부
LEGACY_ACCESS_TOKEN_CUTOFF=

# ── Injective / 온체인 ────────────────────────────────────
INJECTIVE_NETWORK=testnet
# gRPC 엔드포인트 덮어쓰기 (전용 노드/프록시). 비우면 INJECTIVE_NETWORK 프리셋(@injectivelabs/networks)을 쓴다 — 민팅 브로드캐스트와 cw721 스마트 쿼리 모두에 적용
INJECTIVE_GRPC_ENDPOINT=
# CW-721 Nestable 컨트랙트 주소 (2팀 배포 후 채움)
NFT_CONTRACT_ADDRESS=
# 마스터 지갑(민팅 전용) — 운영에서는 Vault/KMS 사용, 로컬 개발용만 env 허용
MASTER_WALLET_MNEMONIC=
# 멀티시그 보상 지갑 주소 (bounty_reward.custody_address 기본값)
REWARD_MULTISIG_ADDRESS=
INJECTIVE_EVM_CHAIN_ID=1439
USDC_EVM_CONTRACT_ADDRESS=0x0C382e685bbeeFE5d3d9C29e29E341fEE8E84C5d

# ── 계획만 있고 아직 코드가 읽지 않는 값 (설정해도 아무 효과 없음 — 구현 시 여기서 꺼내 위 섹션으로 올릴 것) ──
# Cloudflare Turnstile 가입 봇 방지 (docs/security.md Phase 1 미완 항목):   TURNSTILE_SECRET_KEY
# Supabase Storage 첨부 업로드 (docs/security.md Phase 2~3):              SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
